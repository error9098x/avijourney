  "cards": [
    {
      "dot": "orange",
      "title": "Terminology the mentors fixed",
      "items": [
        "Scenario became case, because that is what economists say",
        "A baseline is a reference run, a reform is measured against it",
        "Parameters are reached by opening a case, not from the sidebar"
      ]
    },
    {
      "dot": "rose",
      "title": "Honest progress, not a fake bar",
      "items": [
        "Stage and iteration count, never a percent or an ETA",
        "Failure is reported as a finding with OG-Core's own message",
        "Cancel stops the whole worker process tree"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why results can be trusted",
      "items": [
        "Every completed run stores an input fingerprint",
        "Changing a parameter invalidates that run's results",
        "Rerunning a baseline invalidates the reforms on top of it"
      ]
    }
  ]
