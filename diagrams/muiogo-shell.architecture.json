  "cards": [
    {
      "dot": "orange",
      "title": "Why a shell, not a menu item",
      "items": [
        "OG-Core is a peer of CLEWS, so the switch sits in the header",
        "Switching replaces the sidebar and the working area together",
        "CLEWS keeps its own theme and workflow, untouched"
      ]
    },
    {
      "dot": "cyan",
      "title": "Keeping the fork mergeable",
      "items": [
        "OG markup lives under a .ogc-page root with .ogc-* styles only",
        "All new styling is isolated in muiogo.css",
        "Four upstream files carry small marked insertion points"
      ]
    },
    {
      "dot": "emerald",
      "title": "Who owns which file",
      "items": [
        "OG-Core services own run_meta.json and run_log.txt",
        "The worker owns run_status.json and the result files",
        "A run counts as done only when the worker exits clean"
      ]
    }
  ]
